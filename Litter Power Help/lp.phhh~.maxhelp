								}
							},
							{
								"box": {
									"textcolor": [
										0.870588235294118,
										0.870588235294118,
										0.870588235294118,
										1.0
									],
									"maxclass": "comment",
									"text": "By default (mode 0) lp.pvvv~ & Co. produce the PPC sound on every computer (since 2026; before, they produced the sound native to the processor). By sending the message 'mode 1' you will force the PPC behavior, which is the same as the default. By sending the message 'mode 2' you will force the Intel behavior. 'mode 0' reverts to the default.",
									"linecount": 4,
									"numoutlets": 0,
									"fontsize": 13.0,
									"patching_rect": [
										6.582,
										194.178,
										1007.088,
										80.633
									],
									"fontname": "Arial",
									"id": "obj-10",
									"numinlets": 1
								}
							},
							{
								"box": {
									"textcolor": [
										0.870588235294118,
										0.870588235294118,
										0.870588235294118,
										1.0
									],
									"maxclass": "comment",
									"text": "The answer is: You decide which sound you want.",
									"numoutlets": 0,
									"fontsize": 13.0,
									"patching_rect": [
										6.582,
										164.557,
										398.228,
										27.975
									],
									"fontname": "Arial",
									"id": "obj-11",
									"numinlets": 1
								}
							},
							{
								"box": {
									"textcolor": [
										0.870588235294118,
										0.870588235294118,
										0.870588235294118,
										1.0
									],
									"maxclass": "comment",
									"text": "Since you will generally want your patches to sound the same no matter what hardware is being used, lp.pvvv~ and friends now prefer the \"PPC sound\" everywhere: overflowing values are clipped, which sounds smoother than the jumps of the \"Intel sound\". Send 'mode 2' if you prefer the \"Intel sound\".",
									"linecount": 2,
									"numoutlets": 0,
									"fontsize": 13.0,
									"patching_rect": [
										6.582,
										115.19,
