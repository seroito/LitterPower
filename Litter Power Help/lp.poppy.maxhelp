			{
				"box": {
					"textcolor": [
						0.870588235294118,
						0.870588235294118,
						0.870588235294118,
						1.0
					],
					"maxclass": "comment",
					"text": "The model is extended in that lp.poppy also allows you to specify a cycle of different growth rates. You do this by sending a list in the left inlet.",
					"linecount": 2,
					"numoutlets": 0,
					"fontsize": 13.0,
					"patching_rect": [
						41.14,
						222.9,
						957.722,
						46.076
					],
					"fontname": "Arial",
					"id": "obj-41",
