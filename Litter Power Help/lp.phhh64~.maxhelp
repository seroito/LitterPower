									"numinlets": 1
								}
							},
							{
								"box": {
									"textcolor" : [ 0.0, 0.0, 0.0, 1.0 ],
									"maxclass": "comment",
									"text": "Note: the differences are barely audible with lp.phhh~, but the mode message was included in analogy to lp.pfff~ and lp.pvvv~",
									"numoutlets": 0,
									"fontsize": 7.9,
